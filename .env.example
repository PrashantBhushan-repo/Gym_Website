# Environment Variables Template

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gym_website

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database (Optional - using simple embeddings for now)
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_INDEX_NAME=gym-knowledge

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_SERVICE=gmail

# Session Security
SESSION_SECRET=your_secure_random_session_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Razorpay Payment
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS Origins
FRONTEND_URL=http://localhost:3000,https://your-frontend-domain.vercel.app

# DNS Servers (optional)
DNS_SERVERS=8.8.8.8,8.8.4.4